# 复制为同目录 .env.ltx2 后填写；start_ltx2_t2v_sidecar.sh 会自动 source。
# 注意：这些变量是给「侧车进程」用的，不是 backend/.env（后端只需 LTX2_T2V_ENDPOINT）。

# 本机 ComfyUI（先单独 Queue 跑通 LTX 工作流再开侧车）
LTX2_COMFYUI_URL=http://127.0.0.1:8188

# Save (API Format) 导出的 JSON 绝对路径（见 scripts/ltx2/EXPORT_COMFY_API.md）
# 本仓库推荐：third_party/ltx2/workflows/ltx2_t2v.api.json（需写绝对路径）
LTX2_COMFY_API_JSON=/path/to/ltx2_t2v.api.json

# 侧车会往这些节点 id 写入「口播+画面」合并文案、帧数、fps、EmptyImage 宽高。
# 官方扁平工作流常用 5222/5218/5221/5217；从「Text to Video (LTX 2.0)」模板 Export (API) 时
# 常为子图 id（含冒号），例如：
# LTX2_COMFY_NODE_PROMPT=92:3
# LTX2_COMFY_NODE_FRAMES=92:62
# LTX2_COMFY_NODE_FPS=92:102
# LTX2_COMFY_NODE_EMPTY_IMAGE=92:89
# （若不确定：在 ltx2_t2v.api.json 里搜 CLIPTextEncode 的正向提示、PrimitiveInt「Length」、
#   PrimitiveFloat「Frame Rate」、EmptyImage。）
#
# 旧版扁平示例（与 bundled UI 工作流一致时）：
# LTX2_COMFY_NODE_PROMPT=5222
# LTX2_COMFY_NODE_FRAMES=5218
# LTX2_COMFY_NODE_FPS=5221
# LTX2_COMFY_NODE_EMPTY_IMAGE=5217

# Comfy 排队超时（秒）
# LTX2_COMFY_TIMEOUT=7200

# 口播兜底音色（仅 Comfy 失败或未配置时使用）
# LTX2_EDGE_VOICE=zh-CN-XiaoxiaoNeural

# 侧车 Comfy 失败时打印堆栈到 stderr
# LTX2_DEBUG=1
