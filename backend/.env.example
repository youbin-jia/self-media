# ============================================
# 自媒体视频自动化平台 - 环境配置模板
# ============================================
# 复制此文件为 .env 并填写相应配置

# ============================================
# 基础配置
# ============================================

# 运行环境: development | production
ENVIRONMENT=development

# 数据库连接URL
# SQLite (开发环境): sqlite:///./data/video_automation.db
# PostgreSQL (生产环境): postgresql://user:password@localhost:5432/video_automation
DATABASE_URL=sqlite:///./data/video_automation.db

# Redis连接URL
REDIS_URL=redis://localhost:6379/0

# ============================================
# 安全配置 (生产环境必须修改!)
# ============================================

# JWT签名密钥 - 生产环境必须设置为随机字符串!
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# 应用密钥
SECRET_KEY=your-app-secret-key-change-in-production

# JWT Token有效期(小时)
JWT_ACCESS_TOKEN_EXPIRE_HOURS=168

# ============================================
# LLM 配置
# ============================================

# Anthropic (Claude) API
ANTHROPIC_API_KEY=your_claude_api_key_here

# OpenAI API (GPT + DALL-E)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4-turbo

# Kimi (Moonshot, OpenAI-compatible)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# GLM 本地模型端点 (可选)
GLM_ENDPOINT=

# 默认LLM提供商: claude | openai | kimi | glm
DEFAULT_LLM_PROVIDER=claude

# 是否启用LLM降级 (当主提供商失败时尝试备用)
LLM_FALLBACK_ENABLED=true

# 评审机制说明：
# review 步骤默认采用“规则评分 + 大模型爆款模板评审”的混合模式；
# 当大模型不可用时，会自动回退到规则评分，不会阻断流程。

# ============================================
# TTS 配置 (语音合成)
# ============================================

# Azure Speech Service
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia

# ElevenLabs (可选)
ELEVENLABS_API_KEY=

# 阿里云 NLS TTS (可选)
# 获取方式：先在阿里云智能语音控制台创建项目获得 APP_KEY。
# 推荐配置 AccessKey 以启用自动刷新 Token（无需手工维护 TOKEN）。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 可选：若你手工提供临时 Token，可填该项；配置 AK/SK 后可自动刷新
ALIYUN_TTS_TOKEN=
ALIYUN_TTS_APP_KEY=
ALIYUN_TTS_REGION=cn-shanghai
ALIYUN_TTS_VOICE=xiaoyun

# 默认TTS提供商: azure | elevenlabs | aliyun
DEFAULT_TTS_PROVIDER=azure

# ============================================
# AI 图像生成配置
# ============================================

# DALL-E (使用OPENAI_API_KEY，可单独设置)
DALLE_API_KEY=

# Midjourney (第三方API，可选)
MIDJOURNEY_API_KEY=
MIDJOURNEY_ENDPOINT=

# Suno AI (音乐生成，可选)
SUNO_API_KEY=
SUNO_ENDPOINT=

# 默认AI生成提供商: dalle | midjourney
DEFAULT_AI_GENERATION_PROVIDER=dalle

# ============================================
# 通义万相 Wan2.1 图生视频（本地，可选）
# ============================================
# 详见仓库 docs/WAN2.1_LOCAL.md。启用后：分镜时间轴在「有参考图」时优先生成 I2V 短视频再拼接。
WAN_I2V_ENABLED=false
# subprocess=本机执行官方 generate.py | http=调用侧车（scripts/wan_i2v_sidecar.py）
WAN_I2V_MODE=subprocess
WAN_I2V_REPO_DIR=
WAN_I2V_CKPT_DIR=
WAN_I2V_PYTHON=python
WAN_I2V_TASK=i2v-14B
WAN_I2V_SIZE=1280*720
# 显存紧张时示例: --offload_model True --t5_cpu
WAN_I2V_EXTRA_ARGS=
WAN_I2V_TIMEOUT_SEC=7200
# HTTP 模式：侧车地址，如 http://127.0.0.1:9810
WAN_I2V_ENDPOINT=
WAN_I2V_HTTP_BEARER=

# ============================================
# 素材源API配置
# ============================================

# Pexels (免费图片/视频)
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay (免费图片)
PIXABAY_API_KEY=

# Unsplash (免费图片)
UNSPLASH_ACCESS_KEY=

# ============================================
# 缓存配置
# ============================================

# 缓存TTL (秒)
CACHE_TTL_USER=3600
CACHE_TTL_PROJECT=1800
CACHE_TTL_PROJECT_LIST=600
CACHE_TTL_HOT_TOPICS=300
CACHE_TTL_SEARCH=3600
CACHE_TTL_DASHBOARD=900

# ============================================
# Celery 配置
# ============================================

# Worker并发数
CELERY_WORKER_CONCURRENCY=4

# 预取任务数
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# 任务确认模式
CELERY_TASK_ACKS_LATE=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true

# 任务结果缓存TTL
CELERY_TASK_RESULT_CACHE_TTL=3600

# ============================================
# 存储配置
# ============================================

# 数据存储目录
DATA_DIR=./data